---
/**
 * Filter controls for the game list: multi-select categories (checkboxes) and a
 * single publisher (select). Behavior is wired up by the script on the page that
 * renders this component, which looks for the `data-testid` hooks below.
 */
import type { Category, Publisher } from '../types/game';

interface Props {
    /** Categories offered as checkboxes. */
    categories: Category[];
    /** Publishers offered in the select. */
    publishers: Publisher[];
}

const { categories, publishers } = Astro.props;
---

<form
    class="mb-8 bg-slate-800/60 rounded-xl border border-slate-700/50 p-6 space-y-5"
    data-testid="game-filters"
    aria-label="ゲームの絞り込み"
>
    <fieldset>
        <legend class="text-sm font-medium text-slate-200 mb-3">カテゴリー</legend>
        <div class="flex flex-wrap gap-3">
            {categories.map((category) => (
                <label class="inline-flex items-center gap-2 text-slate-200 bg-slate-700/50 rounded-lg px-3 py-2 cursor-pointer hover:bg-slate-700 transition-colors">
                    <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class="h-4 w-4 rounded border-slate-500 bg-slate-800 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                        data-testid={`filter-category-${category.id}`}
                    />
                    <span>{category.name}</span>
                </label>
            ))}
        </div>
    </fieldset>

    <div>
        <label for="filter-publisher" class="block text-sm font-medium text-slate-200 mb-2">パブリッシャー</label>
        <select
            id="filter-publisher"
            name="publisher"
            class="w-full sm:w-72 rounded-lg bg-slate-700 text-slate-100 border border-slate-600 px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="filter-publisher"
        >
            <option value="">すべて</option>
            {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
        </select>
    </div>

    <div class="flex flex-wrap items-center gap-4">
        <button
            type="reset"
            class="rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-100 px-4 py-2 transition-colors focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="filter-reset"
        >
            絞り込みをリセット
        </button>
        <p class="text-sm text-slate-300" role="status" aria-live="polite" data-testid="filter-result-count"></p>
    </div>
</form>
